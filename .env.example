# Copy to .env to override the docker-compose dev defaults (docker compose loads
# .env automatically). Not required for local dev - docker-compose.yml already has
# working fallback values for all of these.

# Database credentials (PostgreSQL)
DB_USER=cloudnotes_user
DB_PASSWORD=cloudnotes_password

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/cloudnotes

# JWT signing secret key (32+ bytes)
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLTMyLWJ5dGUtc2VjcmV0LWtleS1mb3ItZGV2ZWxvcG1lbnQ=
JWT_EXPIRATION_MS=3600000

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret

